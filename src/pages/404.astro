---
import Base from "../layouts/Base.astro";
import { url } from "../site";
---

<Base title="Page not found">
  <div class="page">
    <h1>Page not found</h1>
    <p>This poster may have moved or been removed. <a href={url()}>Browse all posters</a>.</p>
  </div>
</Base>

<style>
  h1 {
    margin-top: 4rem;
    font-size: var(--text-display);
  }

  p {
    margin-top: 1rem;
    color: var(--muted);
  }
</style>
