---
import Icon from "../../components/Icon.astro";
import Base from "../../layouts/Base.astro";
import {
  bibtex,
  formatBytes,
  getPosters,
  pdfUrl,
  sourceLink,
  editableLink,
  thumbSrc,
  thumbSrcset,
  type Poster,
} from "../../lib/posters";
import { groupFields } from "../../lib/taxonomy";
import { thesisLevels } from "../../lib/thesis";
import { url } from "../../site";

export async function getStaticPaths() {
  const posters = await getPosters();
  return posters.map((poster) => ({ params: { slug: poster.slug }, props: { poster } }));
}

interface Props {
  poster: Poster;
}

const { poster: p } = Astro.props;

const pageUrl = Astro.site ? new URL(url(`posters/${p.slug}/`), Astro.site).href : undefined;
const source = sourceLink(p, "poster");
const abstract = p.asset.abstract;
const abstractSource = sourceLink(p, "abstract");
const editable = editableLink(p);
const cite = bibtex(p, pageUrl ?? "");

// Number affiliations like a paper's author line; one shared affiliation needs no numbers.
const affiliations = [...new Set((p.authors ?? []).flatMap((a) => a.affiliation ?? []))];
const numbered = affiliations.length > 1;
const hasDetails = Boolean(p.conference || p.year || p.thesis || p.tags || p.paper || p.doi);
---

<Base title={p.title} description={p.abstract?.slice(0, 200)} image={thumbSrc(p, 960)}>
  <div class="page">
    <a class="back" href={url()}><Icon name="arrow-left" size={16} />All posters</a>

    <article class="layout">
      <div class="preview">
        <a href={pdfUrl(p)} class="preview-link">
          <img
            class="poster-image"
            src={thumbSrc(p, 960)}
            srcset={thumbSrcset(p)}
            sizes="(min-width: 64rem) 30rem, 100vw"
            width={p.asset.width}
            height={p.asset.height}
            alt={`First page of the poster “${p.title}”`}
          />
        </a>
      </div>

      <div class="body">
        <header>
          {
            p.fields && (
              <p class="eyebrow">
                {groupFields(p.fields).map(({ root, children }, i) => (
                  <>
                    {i > 0 && " · "}
                    <a href={url(`?field=${encodeURIComponent(root.id)}`)}>{root.label}</a>
                    {children.length > 0 && " › "}
                    {children.map((c, j) => (
                      <>
                        {j > 0 && ", "}
                        <a href={url(`?field=${encodeURIComponent(c.id)}`)}>{c.label}</a>
                        {c.scheme && <span class="scheme"> ({c.scheme.label})</span>}
                      </>
                    ))}
                  </>
                ))}
              </p>
            )
          }
          <h1>{p.title}</h1>
          {
            p.authors && (
              <p class="authors">
                {p.authors.map((a, i) => (
                  <>
                    {a.url ? <a href={a.url}>{a.name}</a> : <span>{a.name}</span>}
                    {numbered && a.affiliation && <sup>{affiliations.indexOf(a.affiliation) + 1}</sup>}
                    {a.orcid && (
                      <a class="orcid" href={`https://orcid.org/${a.orcid}`} title={`ORCID ${a.orcid}`}>
                        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                          <circle cx="8" cy="8" r="8" fill="#a6ce39" />
                          <text x="8" y="11.2" fill="#fff" font-family="Arial, sans-serif" font-size="8.5" font-weight="700" text-anchor="middle">
                            iD
                          </text>
                        </svg>
                        <span class="visually-hidden">ORCID iD of {a.name}</span>
                      </a>
                    )}
                    {i < p.authors!.length - 1 && ", "}
                  </>
                ))}
              </p>
            )
          }
          {
            affiliations.length > 0 && (
              <ul class="affiliations">
                {affiliations.map((a, i) => (
                  <li>
                    {numbered && <sup>{i + 1}</sup>}
                    {a}
                  </li>
                ))}
              </ul>
            )
          }
        </header>

        <div class:list={["actions", abstract && "part"]}>
          {abstract && <h2 class="part-label">Poster</h2>}
          <a class="button primary" href={pdfUrl(p)}>View PDF</a>
          <a class="button" href={pdfUrl(p)} download={`${p.slug}.pdf`}>
            <Icon name="download" />
            Download <span class="size">{formatBytes(p.asset.poster.pdfBytes)}</span>
          </a>
          {
            source && (
              <a class="button" href={source.url}>
                <Icon name="code" />
                {source.label}
              </a>
            )
          }
          {
            editable && (
              <a class="button" href={editable.url}>
                <Icon name="copy" />
                {editable.label}
              </a>
            )
          }
          {
            !abstract && p.artifact && (
              <a class="button" href={p.artifact}>
                <Icon name="repo" />
                Artifact
              </a>
            )
          }
        </div>

        {
          abstract && (
            <div class="actions part">
              <h2 class="part-label">Extended abstract</h2>
              {abstract.pdf && (
                <>
                  <a class="button" href={url(abstract.pdf)}>
                    View PDF
                  </a>
                  <a class="button" href={url(abstract.pdf)} download={`${p.slug}-abstract.pdf`}>
                    <Icon name="download" />
                    Download <span class="size">{formatBytes(abstract.pdfBytes!)}</span>
                  </a>
                </>
              )}
              {abstractSource && (
                <a class="button" href={abstractSource.url}>
                  <Icon name="code" />
                  {abstractSource.label}
                </a>
              )}
            </div>
          )
        }
        {/* The artifact belongs to the whole project, so it sits apart from the poster and abstract rows. */}
        {
          abstract && p.artifact && (
            <div class="actions part">
              <a class="button" href={p.artifact}>
                <Icon name="repo" />
                Artifact
              </a>
            </div>
          )
        }

        {
          p.abstract && (
            <section class="abstract">
              <h2>Abstract</h2>
              {p.abstract
                .trim()
                .split(/\n\s*\n/)
                .map((para) => (
                  <p>{para}</p>
                ))}
            </section>
          )
        }

        <section hidden={!hasDetails}>
          <h2>Details</h2>
          <dl class="details">
            {
              p.conference && (
                <>
                  <dt>Presented at</dt>
                  <dd>
                    {p.conference.url ? <a href={p.conference.url}>{p.conference.name}</a> : p.conference.name}
                    {p.conference.location && <span class="muted">, {p.conference.location}</span>}
                  </dd>
                </>
              )
            }
            {
              p.year && (
                <>
                  <dt>Year</dt>
                  <dd class="num">{p.year}</dd>
                </>
              )
            }
            {
              p.thesis && (
                <>
                  <dt>Thesis</dt>
                  <dd>
                    {p.thesis.title ? (
                      <>
                        {thesisLevels[p.thesis.level]}:{" "}
                        {p.thesis.url ? <a href={p.thesis.url}>{p.thesis.title}</a> : p.thesis.title}
                      </>
                    ) : p.thesis.url ? (
                      <a href={p.thesis.url}>{thesisLevels[p.thesis.level]}</a>
                    ) : (
                      thesisLevels[p.thesis.level]
                    )}
                  </dd>
                </>
              )
            }
            {
              p.tags && (
                <>
                  <dt>Tags</dt>
                  <dd>
                    <ul class="tags">
                      {p.tags.map((t) => (
                        <li>
                          <a href={url(`?tag=${encodeURIComponent(t)}`)}>{t}</a>
                        </li>
                      ))}
                    </ul>
                  </dd>
                </>
              )
            }
            {
              p.paper && (
                <>
                  <dt>Paper</dt>
                  <dd>
                    <a class="break" href={p.paper}>
                      {p.paper.replace(/^https?:\/\//, "")}
                    </a>
                  </dd>
                </>
              )
            }
            {
              p.doi && (
                <>
                  <dt>DOI</dt>
                  <dd>
                    <a class="break" href={`https://doi.org/${p.doi}`}>
                      {p.doi}
                    </a>
                  </dd>
                </>
              )
            }
          </dl>
        </section>

        <section>
          <div class="cite-head">
            <h2>Cite</h2>
            <button type="button" class="button copy" data-copy="bibtex">
              <span class="icons">
                <span class="icon-copy"><Icon name="copy" size={16} /></span>
                <span class="icon-check"><Icon name="check" size={16} /></span>
              </span>
              <span class="label">Copy BibTeX</span>
            </button>
          </div>
          <pre id="bibtex">{cite}</pre>
        </section>
      </div>
    </article>
  </div>
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    const label = button.querySelector(".label")!;
    let timer: number | undefined;
    button.addEventListener("click", async () => {
      const text = document.getElementById(button.dataset.copy!)!.textContent!;
      await navigator.clipboard.writeText(text);
      button.dataset.copied = "";
      label.textContent = "Copied";
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        delete button.dataset.copied;
        label.textContent = "Copy BibTeX";
      }, 2000);
    });
  }
</script>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-block: 2rem;
    color: var(--muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .back:hover {
    color: var(--text);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }

  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: minmax(0, 30rem) minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }

    .preview {
      position: sticky;
      top: 2rem;
    }
  }

  .preview {
    padding: clamp(1rem, 3vw, 2rem);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .preview-link {
    display: block;
  }

  .preview img {
    width: 100%;
    height: auto;
    max-height: 80vh;
    object-fit: contain;
    box-shadow: var(--shadow-rest);
  }

  .body {
    max-width: 42rem;
  }

  .eyebrow {
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .eyebrow .scheme {
    font-weight: 400;
  }

  .eyebrow a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  h1 {
    margin-top: 0.5rem;
    font-size: var(--text-display);
    letter-spacing: -0.02em;
    overflow-wrap: break-word;
  }

  .authors {
    margin-top: 1.25rem;
    font-size: var(--text-lg);
  }

  .authors a {
    color: inherit;
  }

  .orcid {
    display: inline-block;
    margin-left: 0.25em;
    vertical-align: -0.1em;
  }

  .orcid svg {
    display: block;
  }

  sup {
    margin-left: 0.1em;
    color: var(--muted);
    font-size: 0.7em;
    line-height: 0;
  }

  .affiliations {
    margin: 0.375rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .affiliations sup {
    margin: 0 0.2em 0 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 2rem;
  }

  .actions.part {
    align-items: center;
  }

  .actions.part + .actions.part {
    margin-top: 1.25rem;
  }

  .part-label {
    flex-basis: 100%;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .size {
    color: var(--muted);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  section {
    margin-top: 3rem;
  }

  h2 {
    font-size: var(--text-xl);
  }

  .abstract p {
    margin-top: 0.75rem;
    max-width: 65ch;
  }

  .details {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.625rem 2rem;
    margin: 1rem 0 0;
  }

  dt {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.75;
  }

  dd {
    margin: 0;
  }

  .muted {
    color: var(--muted);
  }

  .num {
    font-variant-numeric: tabular-nums;
  }

  .break {
    overflow-wrap: anywhere;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags a {
    display: inline-block;
    padding: 0.125rem 0.625rem;
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .tags a:hover {
    background: color-mix(in oklch, var(--surface), var(--text) 8%);
  }

  .cite-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .copy {
    min-height: 2.25rem;
    padding: 0 0.75rem;
  }

  /* Both icons stay in the DOM and cross-fade, so the swap animates in both directions. */
  .icons {
    position: relative;
    display: grid;
    width: 16px;
    height: 16px;
  }

  .icons > span {
    position: absolute;
    inset: 0;
    display: grid;
    transition-property: opacity, scale, filter;
    transition-duration: 200ms;
    transition-timing-function: var(--ease);
  }

  .icon-check {
    opacity: 0;
    scale: 0.25;
    filter: blur(4px);
  }

  [data-copied] .icon-copy {
    opacity: 0;
    scale: 0.25;
    filter: blur(4px);
  }

  [data-copied] .icon-check {
    opacity: 1;
    scale: 1;
    filter: blur(0);
  }

  .label {
    min-width: 6.5em;
    text-align: start;
  }

  pre {
    margin: 1rem 0 0;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    border-radius: var(--radius);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.6;
  }
</style>
